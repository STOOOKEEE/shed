# Account id of the deployed SHED contract (required).
VITE_CONTRACT_ID=shed.example.testnet
# Optional exuviae (burn collection) NFT contract. Defaults to exuviae.<VITE_CONTRACT_ID>.
# VITE_EXUVIAE_ID=exuviae.shed.example.testnet
# testnet (default) or mainnet.
VITE_NETWORK=testnet
# Optional RPC override, e.g. a local sandbox. When set, the app is read-only (no wallet).
# VITE_NODE_URL=http://127.0.0.1:3030
# Optional public repository URL, used for the README / rules links in the footer.
# VITE_REPO_URL=https://github.com/<owner>/near-shed
