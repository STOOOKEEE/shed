# SHED X announcer configuration. Copy to /etc/shed-bot/shed-bot.env (root:root, chmod 600).
# This file must never contain NEAR keys: the bot only reads the chain.

# Contract and RPC (https only). Testnet example below; mainnet uses the mainnet contract and RPC.
SHED_CONTRACT_ID=shedcoin.testnet
SHED_RPC_URL=https://test.rpc.fastnear.com

# Poll period (seconds, >= 5) and minimum delay between two transform summary posts (seconds).
POLL_SECONDS=30
MIN_POST_INTERVAL_SECONDS=1800

# Where the cursor is persisted. Set by the systemd unit (/var/lib/shed-bot) and the Docker image (/data);
# set it yourself for a local run.
# STATE_FILE=./state/state.json
# OUT_DIR=./out

# true = never call X, write would-be posts to OUT_DIR. Flip to false only after checking the dry-run output.
DRY_RUN=true

# Optional https link appended to every post.
# PUBLIC_URL=https://example.com

# debug | info | warn | error
LOG_LEVEL=info

# X app OAuth 1.0a credentials (bot account, Read and write). Required only when DRY_RUN=false.
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
